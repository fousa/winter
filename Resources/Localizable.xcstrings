            "state": "translated",
            "value": "Bezig sinds %@"
          }
        }
      }
    },
    "You can skip this and set it up later; the app works offline either way.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez passer cette étape et la configurer plus tard ; l'app fonctionne hors ligne de toute façon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kan dit overslaan en later instellen; de app werkt toch offline."
          }
        }
      }
    },
    "You pick what you worked on when you stop.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous choisirez sur quoi vous avez travaillé en arrêtant."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waaraan je werkte, kies je bij het stoppen."
          }
        }
      }
    },
    "Your club": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre club"
          }
        },
        "nl": {
