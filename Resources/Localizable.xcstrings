        }
      }
    },
    "Hours appear here once someone has worked and the day is closed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les heures apparaissent ici dès que quelqu'un a travaillé et que la journée est clôturée."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uren verschijnen hier zodra iemand gewerkt heeft en de dag afgesloten is."
          }
        }
      }
    },
