          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het logo van je club"
          }
        }
      }
    },
    "Your club's schema name and an API key from zweef.app": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom du schéma de votre club et une clé API de zweef.app"
          }
        },
