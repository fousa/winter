    "Six digits. Members never need it — it only protects the settings, the tokens and the erase button. Store it with your other club passwords.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Six chiffres. Les membres n'en ont jamais besoin — il protège seulement les réglages, les jetons et le bouton d'effacement. Conservez-le avec les autres mots de passe du club."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zes cijfers. Leden hebben die nooit nodig — ze beschermt alleen de instellingen, de tokens en de wisknop. Bewaar ze bij de andere clubwachtwoorden."
          }
        }
      }
    },
