            "value": "Alles is doorgestuurd"
          }
        }
      }
    },
    "Forgotten it? The app has to be deleted and set up again, and hours that have not been uploaded are lost with it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oublié ? L'app doit être supprimée et reconfigurée, et les heures pas encore envoyées seront perdues."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergeten? Dan moet de app verwijderd en opnieuw ingesteld worden, en gaan uren die nog niet doorgestuurd zijn verloren."
          }
        }
      }
    },
    "Français": {
      "localizations": {
