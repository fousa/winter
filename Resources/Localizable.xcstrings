          "stringUnit": {
            "state": "translated",
            "value": "De schema-naam van je club en een API-sleutel uit zweef.app"
          }
        }
      }
    },
    "^[%lld registration](inflect: true) in period %lld.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@ dans la période %2$lld."
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg enregistrement"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg enregistrements"
                    }
                  }
                }
              }
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@ in periode %2$lld."
