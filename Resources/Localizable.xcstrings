            "state": "translated",
            "value": "Leden ververst"
          }
        }
      }
    },
    "Members, material, hours and the connection are all removed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les membres, le matériel, les heures et la connexion sont tous supprimés."
