    "Forgotten it? The app has to be deleted and set up again, and hours that have not been uploaded are lost with it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oublié ? L'app doit être supprimée et reconfigurée, et les heures pas encore envoyées seront perdues."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergeten? Dan moet de app verwijderd en opnieuw ingesteld worden, en gaan uren die nog niet doorgestuurd zijn verloren."
          }
        }
      }
    },
    "Hours already in zweef.app stay there.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les heures déjà dans zweef.app y restent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uren die al in zweef.app staan blijven daar."
          }
        }
      }
    },
    "Hours appear here once someone has stopped a timer.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les heures apparaissent ici dès que quelqu'un a arrêté un chronomètre."
